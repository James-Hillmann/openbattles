{
  "name": "openbattles",
  "private": true,
  "type": "module",
  "workspaces": [
    "sim",
    "extract",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w @lbw/client",
    "build": "npm run build -w @lbw/client",
    "server": "npm run start -w @lbw/server",
    "start": "npm run start -w @lbw/server",
    "m0": "tsx extract/cli/m0.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p sim && tsc -p extract && tsc -p server && tsc -p client && tsc -p tests",
    "e2e": "tsx tests/e2e/two-tabs.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
